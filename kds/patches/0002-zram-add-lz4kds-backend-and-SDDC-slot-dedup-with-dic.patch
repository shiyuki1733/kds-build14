+#endif
+
 compress_again:
 	zstrm = zcomp_stream_get(zram->comp);
 	src = kmap_atomic(page);
@@ -1777,6 +1830,9 @@ static ssize_t disksize_store(struct device *dev,
 	}
 
 	zram->comp = comp;
+#ifdef CONFIG_ZRAM_SDDC
+	zram->sddc = zram_sddc_create(zram->mem_pool, comp, huge_class_size);
+#endif
