@@ -1263,6 +1280,15 @@ static int __zram_bvec_read(struct zram *zram, struct page *page, u32 index,
 	int ret;
 
 	zram_slot_lock(zram, index);
+#ifdef CONFIG_ZRAM_SDDC
+	if (zram_test_flag(zram, index, ZRAM_SDDC)) {
+		ret = zram_sddc_load(zram->sddc,
+				(void *)zram_get_handle(zram, index), page);
