 	if (zram_test_flag(zram, index, ZRAM_WB)) {
 		struct bio_vec bvec;
 
@@ -1373,6 +1399,33 @@ static int __zram_bvec_write(struct zram *zram, struct bio_vec *bvec,
 	}
 	kunmap_atomic(mem);
 
+#ifdef CONFIG_ZRAM_SDDC
+	if (zram->sddc) {
+		struct zram_sddc_store st;
