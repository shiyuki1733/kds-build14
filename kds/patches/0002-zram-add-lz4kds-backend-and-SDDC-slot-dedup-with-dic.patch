diff --git a/drivers/block/zram/zcomp.c b/drivers/block/zram/zcomp.c
index 0916de9..6fe40ad 100644
--- a/drivers/block/zram/zcomp.c
+++ b/drivers/block/zram/zcomp.c
@@ -7,6 +7,7 @@
 #include <linux/string.h>
 #include <linux/err.h>
 #include <linux/slab.h>
+#include <linux/vmalloc.h>
 #include <linux/wait.h>
 #include <linux/sched.h>
 #include <linux/cpu.h>
@@ -14,6 +15,10 @@
 
 #include "zcomp.h"
 
+#if IS_ENABLED(CONFIG_ZRAM_SDDC)
+extern const struct zcomp_backend_ops lz4kds_zcomp_ops;
+#endif
+
 static const char * const backends[] = {
 #if IS_ENABLED(CONFIG_CRYPTO_LZO)
 	"lzo",
@@ -25,6 +30,21 @@ static const char * const backends[] = {
 #if IS_ENABLED(CONFIG_CRYPTO_LZ4HC)
 	"lz4hc",
 #endif
+#if IS_ENABLED(CONFIG_CRYPTO_LZ4K)
+	"lz4k",
+#endif
+#if IS_ENABLED(CONFIG_CRYPTO_LZ4K_OPLUS)
+	"lz4k_oplus",
+#endif
+#if IS_ENABLED(CONFIG_CRYPTO_LZ4KD)
+	"lz4kd",
+#endif
+#if IS_ENABLED(CONFIG_CRYPTO_DEFLATE)
+	"deflate",
+#endif
+#if IS_ENABLED(CONFIG_ZRAM_SDDC)
+	"lz4kds",
+#endif
 #if IS_ENABLED(CONFIG_CRYPTO_842)
 	"842",
 #endif
@@ -33,12 +53,25 @@ static const char * const backends[] = {
 #endif
 };
 
+/* Backends implemented directly, bypassing the crypto compress API. */
+static const struct zcomp_backend_ops *zcomp_direct_ops(const char *name)
+{
+#if IS_ENABLED(CONFIG_ZRAM_SDDC)
+	if (!strcmp(name, "lz4kds"))
+		return &lz4kds_zcomp_ops;
+#endif
+	return NULL;
+}
+
 static void zcomp_strm_free(struct zcomp_strm *zstrm)
 {
 	if (!IS_ERR_OR_NULL(zstrm->tfm))
 		crypto_free_comp(zstrm->tfm);
+	vfree(zstrm->ctx);
 	free_pages((unsigned long)zstrm->buffer, 1);
 	zstrm->tfm = NULL;
+	zstrm->ctx = NULL;
+	zstrm->ops = NULL;
 	zstrm->buffer = NULL;
 }
 
@@ -48,13 +81,25 @@ static void zcomp_strm_free(struct zcomp_strm *zstrm)
  */
 static int zcomp_strm_init(struct zcomp_strm *zstrm, struct zcomp *comp)
 {
-	zstrm->tfm = crypto_alloc_comp(comp->name, 0, 0);
+	zstrm->ops = comp->ops;
+	if (comp->ops) {
+		if (comp->ops->ctx_size) {
+			zstrm->ctx = vmalloc(comp->ops->ctx_size);
+			if (!zstrm->ctx)
+				return -ENOMEM;
+			memset(zstrm->ctx, 0, comp->ops->ctx_size);
+		}
+	} else {
+		zstrm->tfm = crypto_alloc_comp(comp->name, 0, 0);
+		if (IS_ERR_OR_NULL(zstrm->tfm))
+			return -ENOMEM;
+	}
 	/*
 	 * allocate 2 pages. 1 for compressed data, plus 1 extra for the
 	 * case when compressed size is larger than the original one
 	 */
 	zstrm->buffer = (void *)__get_free_pages(GFP_KERNEL | __GFP_ZERO, 1);
-	if (IS_ERR_OR_NULL(zstrm->tfm) || !zstrm->buffer) {
+	if (!zstrm->buffer) {
 		zcomp_strm_free(zstrm);
 		return -ENOMEM;
 	}
@@ -63,6 +108,8 @@ static int zcomp_strm_init(struct zcomp_strm *zstrm, struct zcomp *comp)
 
 bool zcomp_available_algorithm(const char *comp)
 {
+	if (zcomp_direct_ops(comp))
+		return true;
 	/*
 	 * Crypto does not ignore a trailing new line symbol,
 	 * so make sure you don't supply a string containing
@@ -133,6 +180,18 @@ int zcomp_compress(struct zcomp_strm *zstrm,
 	 */
 	*dst_len = PAGE_SIZE * 2;
 
+	if (zstrm->ops) {
+		size_t len = *dst_len;
+		int ret;
+
+		ret = zstrm->ops->compress(zstrm->ctx, src, PAGE_SIZE,
+					   zstrm->buffer, &len);
+		if (ret)
+			return ret;
+		*dst_len = (unsigned int)len;
+		return 0;
+	}
+
 	return crypto_comp_compress(zstrm->tfm,
 			src, PAGE_SIZE,
 			zstrm->buffer, dst_len);
@@ -143,11 +202,68 @@ int zcomp_decompress(struct zcomp_strm *zstrm,
 {
 	unsigned int dst_len = PAGE_SIZE;
 
+	if (zstrm->ops) {
+		size_t len = dst_len;
+		int ret;
+
+		ret = zstrm->ops->decompress(zstrm->ctx, src, src_len,
+					     dst, &len);
+		if (ret)
+			return ret;
+		if (len != PAGE_SIZE)
+			return -EINVAL;
+		return 0;
+	}
+
 	return crypto_comp_decompress(zstrm->tfm,
 			src, src_len,
 			dst, &dst_len);
 }
 
+bool zcomp_has_delta(struct zcomp *comp)
+{
+	return comp->ops && comp->ops->compress_delta &&
+		comp->ops->decompress_delta;
+}
+
+int zcomp_compress_delta(struct zcomp_strm *zstrm, const void *ref,
+		const void *dst_page, unsigned int *dst_len, unsigned int out_max)
+{
+	size_t len;
+	int ret;
+
+	if (!zstrm->ops || !zstrm->ops->compress_delta)
+		return -EOPNOTSUPP;
+
+	len = out_max;
+	ret = zstrm->ops->compress_delta(zstrm->ctx, ref, dst_page, PAGE_SIZE,
+					 zstrm->buffer, &len, out_max);
+	if (ret)
+		return ret;
+	if (len > out_max)
+		return -EINVAL;
+	*dst_len = (unsigned int)len;
+	return 0;
+}
+
+int zcomp_decompress_delta(struct zcomp_strm *zstrm, const void *src,
+		unsigned int src_len, const void *ref, void *dst)
+{
+	size_t len = PAGE_SIZE;
+	int ret;
+
+	if (!zstrm->ops || !zstrm->ops->decompress_delta)
+		return -EOPNOTSUPP;
+
+	ret = zstrm->ops->decompress_delta(zstrm->ctx, src, src_len, ref,
+					   dst, &len);
+	if (ret)
+		return ret;
+	if (len != PAGE_SIZE)
+		return -EINVAL;
+	return 0;
+}
+
 int zcomp_cpu_up_prepare(unsigned int cpu, struct hlist_node *node)
 {
 	struct zcomp *comp = hlist_entry(node, struct zcomp, node);
@@ -224,6 +340,7 @@ struct zcomp *zcomp_create(const char *compress)
 		return ERR_PTR(-ENOMEM);
 
 	comp->name = compress;
+	comp->ops = zcomp_direct_ops(compress);
 	error = zcomp_init(comp);
 	if (error) {
 		kfree(comp);
diff --git a/drivers/block/zram/zcomp.h b/drivers/block/zram/zcomp.h
index 40f6420..4f63ca3 100644
--- a/drivers/block/zram/zcomp.h
+++ b/drivers/block/zram/zcomp.h
@@ -7,18 +7,47 @@
 #define _ZCOMP_H_
 #include <linux/local_lock.h>
 
+/*
+ * Direct (non crypto API) compression backend.  Needed by algorithms that
+ * carry more per-cpu state than the crypto compress API can hold, or that
+ * implement delta (dictionary) compression, which the crypto API has no
+ * interface for.
+ *
+ * ->decompress may run from the zram read path while the slot bit spinlock
+ * is held, so it must never sleep.
+ */
+struct zcomp_backend_ops {
+	int (*compress)(void *ctx, const void *src, size_t src_len,
+			void *dst, size_t *dst_len);
+	int (*decompress)(void *ctx, const void *src, size_t src_len,
+			void *dst, size_t *dst_len);
+	/* Optional dictionary compression against a reference page. */
+	int (*compress_delta)(void *ctx, const void *ref, const void *src,
+			      size_t src_len, void *dst, size_t *dst_len,
+			      size_t out_max);
+	int (*decompress_delta)(void *ctx, const void *src, size_t src_len,
+				const void *ref, void *dst, size_t *dst_len);
+	/* Size of the per-cpu context, 0 when the backend needs none. */
+	size_t ctx_size;
+};
+
 struct zcomp_strm {
 	/* The members ->buffer and ->tfm are protected by ->lock. */
 	local_lock_t lock;
 	/* compression/decompression buffer */
 	void *buffer;
 	struct crypto_comp *tfm;
+	/* direct backend context (per-cpu) */
+	void *ctx;
+	/* non-NULL when this stream uses a direct backend */
+	const struct zcomp_backend_ops *ops;
 };
 
 /* dynamic per-device compression frontend */
 struct zcomp {
 	struct zcomp_strm __percpu *stream;
 	const char *name;
+	const struct zcomp_backend_ops *ops;
 	struct hlist_node node;
 };
 
@@ -40,4 +69,12 @@ int zcomp_decompress(struct zcomp_strm *zstrm,
 		const void *src, unsigned int src_len, void *dst);
 
 bool zcomp_set_max_streams(struct zcomp *comp, int num_strm);
+
+/* Delta (dictionary) compression; available only on kds style backends. */
+bool zcomp_has_delta(struct zcomp *comp);
+int zcomp_compress_delta(struct zcomp_strm *zstrm, const void *ref,
+		const void *src, unsigned int *dst_len, unsigned int out_max);
+int zcomp_decompress_delta(struct zcomp_strm *zstrm, const void *src,
+		unsigned int src_len, const void *ref, void *dst);
+
 #endif /* _ZCOMP_H_ */
diff --git a/drivers/block/zram/zram_drv.c b/drivers/block/zram/zram_drv.c
